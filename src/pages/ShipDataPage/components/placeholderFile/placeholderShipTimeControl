import React, { useState, useMemo, useEffect, useRef } from "react";
import {
    Stack,
    IconButton,
    Box,
    Paper,
    Typography,
    TextField,
    Collapse,
} from "@mui/material";
import { ExpandMore, ExpandLess } from "@mui/icons-material";

export function ShipTimeControl({
    ships,
    onTimeChange,
    controlRef,
    isAnimating = false,
    currentAnimationIndex = null,
    availableTimes: externalAvailableTimes = null,
}) {
    const [isExpanded, setIsExpanded] = useState(false);
    const computedAvailableTimes = useMemo(() => {
        const timeSet = new Set();
        ships.forEach((ship) =>
            ship.locations.forEach((loc) => timeSet.add(loc.time)),
        );
        return Array.from(timeSet).sort((a, b) => a - b);
    }, [ships]);

    const availableTimes = externalAvailableTimes || computedAvailableTimes;
    const [currentIndex, setCurrentIndex] = useState(
        () => availableTimes.length - 1,
    );
    const initializedRef = useRef(false);

    useEffect(() => {
        if (!initializedRef.current && availableTimes.length > 0) {
            const endTime = availableTimes[availableTimes.length - 1];
            onTimeChange([availableTimes[0], endTime]);
            initializedRef.current = true;
        }
    }, [availableTimes, onTimeChange]);

    useEffect(() => {
        if (isAnimating && currentAnimationIndex !== null) {
            setCurrentIndex(currentAnimationIndex);
        }
    }, [isAnimating, currentAnimationIndex]);

    const handleDateChange = (event) => {
        const newDate = event.target.value; // YYYY-MM-DD
        const currentTime = availableTimes[currentIndex];
        const currentDate = new Date(currentTime);

        // Preserve the time, change only the date
        const [year, month, day] = newDate.split("-").map(Number);
        const newDateTime = new Date(currentDate);
        newDateTime.setFullYear(year);
        newDateTime.setMonth(month - 1);
        newDateTime.setDate(day);

        updateToClosestTime(newDateTime.getTime());
    };

    const handleTimeChange = (event) => {
        const newTime = event.target.value; // HH:mm
        const currentTimestamp = availableTimes[currentIndex];
        const currentDate = new Date(currentTimestamp);

        // Parse time input (handles both 12-hour with AM/PM and 24-hour)
        const [hours, minutes] = newTime.split(":").map(Number);

        const newDateTime = new Date(currentDate);
        newDateTime.setHours(hours);
        newDateTime.setMinutes(minutes);
        newDateTime.setSeconds(0);
        newDateTime.setMilliseconds(0);

        updateToClosestTime(newDateTime.getTime());
    };

    const updateToClosestTime = (targetTimestamp) => {
        const minTime = availableTimes[0];
        const maxTime = availableTimes[availableTimes.length - 1];

        // Clamp to valid range
        const clampedTimestamp = Math.max(
            minTime,
            Math.min(maxTime, targetTimestamp),
        );

        // Find closest available time
        const closestIndex = availableTimes.reduce((prev, curr, idx) => {
            return Math.abs(curr - clampedTimestamp) <
                Math.abs(availableTimes[prev] - clampedTimestamp)
                ? idx
                : prev;
        }, 0);

        setCurrentIndex(closestIndex);
        const selectedTime = availableTimes[closestIndex];

        onTimeChange([availableTimes[0], selectedTime]);
    };

    const formatToDate = (timestamp) => {
        const date = new Date(timestamp);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
    };

    const formatToTime = (timestamp) => {
        const date = new Date(timestamp);
        const hours = String(date.getHours()).padStart(2, "0");
        const minutes = String(date.getMinutes()).padStart(2, "0");
        return `${hours}:${minutes}`;
    };

    const formatTime = (timestamp) => new Date(timestamp).toLocaleString();

    if (availableTimes.length === 0) return null;

    return (
        <Paper
            ref={controlRef}
            sx={{
                position: "absolute",
                top: 20,
                left: "50%",
                transform: "translateX(-50%)",
                width: "600px",
                backgroundColor: "white",
                padding: "20px",
                borderRadius: "8px",
                boxShadow: "0 2px 8px rgba(0,0,0,0.2)",
                pointerEvents: "auto",
                zIndex: 1000,
            }}
        >
            <Stack
                direction="row"
                alignItems="center"
                justifyContent="space-between"
                sx={{ marginBottom: isExpanded ? 2 : 0 }}
            >
                <Typography variant="h6" sx={{ fontWeight: "bold" }}>
                    Time Clock{" "}
                    {isAnimating && (
                        <span style={{ color: "#1976d2" }}>(Animating...)</span>
                    )}
                </Typography>
                <IconButton
                    size="small"
                    onClick={() => setIsExpanded(!isExpanded)}
                    sx={{ marginLeft: 2 }}
                >
                    {isExpanded ? <ExpandLess /> : <ExpandMore />}
                </IconButton>
            </Stack>
            <Collapse in={isExpanded}>
                <Box sx={{ px: 2 }}>
                    {/* Time Input - Large and prominent */}
                    <Box sx={{ mb: 2 }}>
                        <Typography
                            variant="caption"
                            sx={{ display: "block", mb: 0.5, color: "#666" }}
                        >
                            Time
                        </Typography>
                        <TextField
                            type="time"
                            value={formatToTime(availableTimes[currentIndex])}
                            onChange={handleTimeChange}
                            disabled={isAnimating}
                            fullWidth
                            InputProps={{
                                sx: {
                                    fontSize: "2rem",
                                    fontWeight: "bold",
                                    "& input": {
                                        textAlign: "center",
                                        padding: "16px",
                                    },
                                },
                                inputProps: {
                                    step: 60, // 1 minute increments
                                },
                            }}
                        />
                    </Box>

                    {/* Date Input - Smaller */}
                    <Box sx={{ mb: 2 }}>
                        <Typography
                            variant="caption"
                            sx={{ display: "block", mb: 0.5, color: "#666" }}
                        >
                            Date
                        </Typography>
                        <TextField
                            type="date"
                            value={formatToDate(availableTimes[currentIndex])}
                            onChange={handleDateChange}
                            disabled={isAnimating}
                            fullWidth
                            InputProps={{
                                sx: {
                                    fontSize: "0.9rem",
                                    "& input": {
                                        padding: "8px",
                                    },
                                },
                                inputProps: {
                                    min: formatToDate(availableTimes[0]),
                                    max: formatToDate(availableTimes[availableTimes.length - 1]),
                                },
                            }}
                        />
                    </Box>

                    <Box
                        sx={{
                            display: "flex",
                            justifyContent: "space-between",
                            mt: 1,
                            fontSize: 12,
                            color: "#666",
                        }}
                    >
                        <span>Min: {formatTime(availableTimes[0])}</span>
                        <span>
                            Max: {formatTime(availableTimes[availableTimes.length - 1])}
                        </span>
                    </Box>
                </Box>
            </Collapse>
        </Paper>
    );
}
